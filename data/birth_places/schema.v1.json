{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mvkaiii/metaphysics-lab/data/birth_places/schema.v1.json",
  "title": "Metaphysics Lab Offline Birth Place Registry v1",
  "type": "object",
  "required": ["version", "coverage_profile", "records"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "coverage_profile": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "canonical_name",
          "country_code",
          "admin_area",
          "latitude",
          "longitude",
          "timezone",
          "aliases",
          "source",
          "source_version",
          "source_reference"
        ],
        "additionalProperties": false,
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "canonical_name": {"type": "string", "minLength": 1},
          "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
          "admin_area": {"type": ["string", "null"]},
          "latitude": {"type": "number", "minimum": -90, "maximum": 90},
          "longitude": {"type": "number", "minimum": -180, "maximum": 180},
          "timezone": {"type": "string", "minLength": 1},
          "aliases": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "source": {"type": "string", "minLength": 1},
          "source_version": {"type": "string", "minLength": 1},
          "source_reference": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
